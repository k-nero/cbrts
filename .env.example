# Copy to .env and fill in. docker compose reads it automatically.

DB_USERNAME=postgres
DB_PASSWORD=change-me

# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=

# File storage (SeaweedFS). The secret is required. Generate one with: openssl rand -base64 32
S3_ACCESS_KEY=cbrts
S3_SECRET_KEY=

# Password for the seeded demo accounts
SEED_PASSWORD=changeme123!

# Host ports
WEB_PORT=3000
API_PORT=8080
DB_PORT=5433
S3_PORT=8333
