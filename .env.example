# Copy to .env and fill in. docker compose reads it automatically. The names are Spring Boot's relaxed
# property names (SPRING_DATASOURCE_PASSWORD -> spring.datasource.password), so the same file can also
# override a local run: set -a && . ./.env && set +a.

SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=

# File storage (SeaweedFS). The secret is required. Generate one with: openssl rand -base64 32
APP_STORAGE_S3_ACCESSKEY=cbrts
APP_STORAGE_S3_SECRETKEY=

# Card payment through Stripe Checkout. Leave the secret key empty to keep it off (bank transfer only). Use test-mode
# keys (sk_test_...) from the Stripe dashboard; the webhook secret (whsec_...) comes from the dashboard's webhook
# endpoint, or from `stripe listen --api-key <the secret key above> --print-secret` on a developer machine (see README).
APP_PAYMENT_STRIPE_SECRETKEY=sk_test_
APP_PAYMENT_STRIPE_WEBHOOKSECRET=whsec_
# The web app's origin, where Stripe sends the customer back to the invoice
APP_PAYMENT_RETURNURL=http://localhost:3000

# Password for the seeded demo accounts
APP_SEED_DEFAULT_PASSWORD=changeme123!

# Host ports (compose only)
WEB_PORT=3000
API_PORT=8080
DB_PORT=5433
S3_PORT=8333
